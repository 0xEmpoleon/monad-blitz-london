# Public Monad Testnet RPC used by the web app.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional canonical production URL for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://mandatelab.vercel.app

# Filled after event-window deployment.
NEXT_PUBLIC_MANDATE_EXECUTOR_ADDRESS=
NEXT_PUBLIC_DEMO_MARKET_ADDRESS=

# Deployment only. Never expose this as NEXT_PUBLIC_* or commit the value.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=
